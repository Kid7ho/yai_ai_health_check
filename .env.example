# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#   cp .env.example .env

# Liner Academic Search API 키. 요청 헤더 x-api-key로 전달된다.
LINER_API_KEY=

# 식약처 오픈API 인증키 (식품안전나라). 아직 발급 대기 중이면 비워 둔다.
MFDS_API_KEY=

# fake  키 없이 Fake 어댑터로 전체 경로를 돌린다 (기본값)
# live  실제 외부 API를 호출한다. 해당 키가 있어야 한다
ADAPTER_MODE=fake

# 비동기 워커 개수. 늘리면 동시 처리량과 함께 외부 API 호출도 늘어난다
WORKER_COUNT=2

# ── 자막 추출 프록시 ────────────────────────────────────────────
# YouTube는 클라우드 제공자 IP를 대부분 차단한다. 서버에 올릴 때는 둘 중
# 하나를 설정해야 자막 추출이 동작한다. 로컬 개발에서는 비워 둔다.
#
# 일반 프록시 (http://사용자:비밀번호@host:port 형식)
YOUTUBE_PROXY_URL=
# Webshare 회전 주거용 프록시 (라이브러리가 공식 지원)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# 자막 호출 간 최소 간격(초). 몰아 부르면 차단을 부른다
TRANSCRIPT_MIN_INTERVAL=1.5
# 차단 감지 후 자막 호출을 멈추는 시간(초)
TRANSCRIPT_COOLDOWN=600

# ── 음성 인식 (자막 없는 영상 대체 경로) ────────────────────────
# 켜면 자막이 없을 때 음성을 글로 옮긴다. 대가가 크다.
#   · 응답이 초 단위에서 분 단위로 늘어난다
#   · 첫 실행에서 모델 파일을 수백 MB 내려받는다
#   · 자동 생성 자막과 비슷한 정확도다
# 설치: pip install -e ".[asr]"
ASR_ENABLED=0
# tiny | base | small | medium | large-v3 — 한국어는 small 이상을 권한다
ASR_MODEL_SIZE=small
# 음성 인식할 최대 길이(초). 0이면 영상 전체
ASR_MAX_SECONDS=300

# ── 기사·블로그 본문 추출 ───────────────────────────────────────
ARTICLE_ENABLED=1

# ── 디버그 화면 ────────────────────────────────────────────────
# 배포 시에는 0으로 끈다
DEBUG_UI=1

# ── 저장소 ─────────────────────────────────────────────────────
# 판정 기록과 목표 지표가 쌓인다. :memory:로 두면 재시작 시 사라진다
DATABASE_PATH=healthcheck.db
# 개인정보 보존 기간(일). README의 저장 데이터 표와 같은 값
TEXT_RETENTION_DAYS=90
USER_KEY_RETENTION_DAYS=30

# ── 스킬 엔드포인트 보호 ────────────────────────────────────────
# 공개 주소로 노출하면 최소 하나는 반드시 켠다. 인증이 없으면 주소를 아는
# 누구나 파이프라인을 호출하고 Liner 토큰이 남의 요청에 쓰인다.
#
# 방법 1: 헤더 토큰. 오픈빌더 스킬 설정에서 헤더를 지정할 수 있으면 이쪽.
#   토큰은 아래 명령으로 만든다: python -c "import secrets;print(secrets.token_urlsafe(32))"
SKILL_AUTH_HEADER=X-Skill-Token
SKILL_AUTH_TOKEN=
#
# 방법 2: 비밀 경로. 헤더를 지정할 수 없을 때 쓴다.
#   예: /skill/3f9a2c7b1d8e  (이 경로 전체가 오픈빌더에 넣는 스킬 URL이 된다)
SKILL_PATH=/skill

# 로그 수준. 이 값이 없으면 판정 로그와 조회 로그가 보이지 않는다
LOG_LEVEL=INFO

# 콜백을 보내도 되는 호스트 끝부분(쉼표 구분). 실제 카카오 콜백 주소를 확인하면 바꾼다
CALLBACK_ALLOWED_SUFFIXES=kakao.com,kakaoenterprise.com

# scripts/server_start.sh가 연결할 ngrok 고정 주소(비밀값 아님). 예: 이름.ngrok-free.dev
NGROK_DOMAIN=

# 결과 카드 머리 이미지를 카카오가 내려받을 공개 https 주소. 비우면 이미지 없는 카드로 답한다.
# scripts/server_start.sh는 NGROK_DOMAIN으로 자동으로 채운다.
PUBLIC_BASE_URL=
