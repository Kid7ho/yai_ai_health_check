# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#   cp .env.example .env

# Liner Academic Search API 키. 요청 헤더 x-api-key로 전달된다.
LINER_API_KEY=

# 식약처 오픈API 인증키 (식품안전나라). 아직 발급 대기 중이면 비워 둔다.
MFDS_API_KEY=

# fake  키 없이 Fake 어댑터로 전체 경로를 돌린다 (기본값)
# live  실제 외부 API를 호출한다. 해당 키가 있어야 한다
ADAPTER_MODE=fake

# 비동기 워커 개수. 늘리면 동시 처리량과 함께 외부 API 호출도 늘어난다
WORKER_COUNT=2
